# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=digital_price_board
MYSQL_USER=dpb_app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

# Aplikasi / Prisma
DATABASE_URL=mysql://dpb_app:change-me-app@localhost:3307/digital_price_board
APP_URL=http://localhost:3000

# Auth
# Durasi sesi owner dalam detik (jangan hardcode di kode aplikasi)
SESSION_MAX_AGE=604800

# Secrets — generate dengan: openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret
DISPLAY_TOKEN_SECRET=change-me-display-token-secretSEED_OWNER_PASSWORD=change-me-owner
