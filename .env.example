# MySQL (docker-compose)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=digital_price_board
MYSQL_USER=dpb_app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

# Port aplikasi container (host)
APP_PORT=3000

# Aplikasi / Prisma
# DATABASE_URL di bawah untuk menjalankan langsung di host (dev).
# Saat dijalankan via docker-compose, URL otomatis memakai host "db" (dibuat oleh compose).
DATABASE_URL=mysql://dpb_app:change-me-app@localhost:3307/digital_price_board

# URL publik aplikasi. Saat production, ganti dengan domain sebenarnya (dipakai
# untuk membangun URL display pada fitur "Daftarkan Perangkat Display").
# Skema https:// akan mengaktifkan atribut Secure pada cookie sesi; gunakan
# http:// hanya untuk dev/akses LAN lokal di dalam jaringan toko.
APP_URL=http://localhost:3000

# Auth
# Durasi sesi owner dalam detik (jangan hardcode di kode aplikasi)
SESSION_MAX_AGE=604800

# Secrets — generate dengan: openssl rand -base64 32
AUTH_SECRET=change-me-auth-secret
DISPLAY_TOKEN_SECRET=change-me-display-token-secret

# Seed on container start (0/1). Aktifkan dgn "1" saat deployment pertama.
SEED=0
SEED_OWNER_PASSWORD=change-me-owner
SEED_DISPLAY_TOKEN=dev-display-token
